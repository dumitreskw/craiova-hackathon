# Standalone host only (docker-compose.yml): TLS from Let's Encrypt, nothing
# else. Sign-in is the app's own (Keycloak, docs/10-auth.md); the app serves
# the landing page, the analyst app, /auth/* and the authenticated /mcp.
{$OSINT_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:8000 {
		# Server-sent events (live graph, agent transcripts) must not buffer.
		flush_interval -1
	}
}
