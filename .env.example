# Copy to .env and fill in. Never commit .env.

# --- Access -------------------------------------------------------------------
# Public hostname (DNS A record -> this server). "localhost" for a local test.
OSINT_DOMAIN=osint.example.com
# Where the platform is reached (sign-in redirects, secure cookies).
OSINT_PUBLIC_URL=https://osint.example.com

# --- Sign-in (Keycloak, docs/10-auth.md) ------------------------------------------
# The realm and the app's confidential client, as printed by
# scripts/keycloak_bootstrap.py. Leave OSINT_OIDC_ISSUER empty ONLY for local
# development: sign-in is then off and every request acts as one local owner.
OSINT_OIDC_ISSUER=
OSINT_OIDC_CLIENT_ID=osint-web
OSINT_OIDC_CLIENT_SECRET=
# Plan of the workspace every new account gets (free | team | enterprise).
# OSINT_DEFAULT_PLAN=free
# OSINT_SESSION_DAYS=14

# --- Claude agents --------------------------------------------------------------
# Without a key, quick scan + the graph draft report still work.
ANTHROPIC_API_KEY=
# OSINT_AGENT_MODEL=claude-opus-5-5
# Deep-analysis workers (many lookups, cheaper model):
# OSINT_WORKER_MODEL=claude-sonnet-5-5
# OSINT_AGENT_PROGRESS_UPDATES=1

# --- Venice AI (optional alternative model provider) ----------------------------
# Lets you assign a Venice model (OpenAI-compatible) to any agent task from the
# Models settings page in the UI. With a key set, the live Venice catalogue is
# listed and selectable. This is a per-task provider choice, not a refusal
# fallback: a declined turn still ends the run.
VENICE_INFERENCE_KEY=
# VENICE_BASE_URL=https://api.venice.ai/api/v1

# --- Connector keys (optional; each connector skips cleanly without its key) -------
GITHUB_TOKEN=
OPENSANCTIONS_API_KEY=
# Free tiers: passive DNS, scan history, subfinder sources
OTX_API_KEY=
URLSCAN_API_KEY=
CERTSPOTTER_API_KEY=
DNSDUMPSTER_API_KEY=
NETLAS_API_KEY=
CHAOS_API_KEY=
WHOISXML_API_KEY=
# Metered (monthly quota, enforced by the ledger): hunter 50, tomba 25
HUNTER_API_KEY=
TOMBA_API_KEY=
TOMBA_API_SECRET=
# Paid credits: only with costly_connectors="all"
DEHASHED_API_KEY=
# UK Companies House (free key): developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=
# Have I Been Pwned (Core 1, ~US$4.39/month billed yearly): haveibeenpwned.com/API/Key
HIBP_API_KEY=
# VirusTotal public API (free: 4 requests/min, 500/day): virustotal.com > API key
VIRUSTOTAL_API_KEY=

# --- Search & page reading ------------------------------------------------------------
# SearXNG runs in the stack (SEARXNG_URL is set by docker-compose). Secret for it:
SEARXNG_SECRET=
# Firecrawl (optional, best markdown + anti-bot): hosted (key) or self-hosted (URL).
# Without it, pages are read with Lightpanda (bundled) or plain HTTP.
# FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=http://firecrawl-api:3002
# Local development without the tools installed: run them on the Kali VM over ssh.
# OSINT_KALI_SSH=kali

# --- Collection egress -------------------------------------------------------------
# Route connector + screenshot traffic through the VPN container
# (docker compose --profile egress up -d) or any HTTP proxy:
# OSINT_HTTP_PROXY=http://egress:8888
# Recorded on every finding, e.g. "mullvad-ro-buh" or "vps-fra1":
# OSINT_EGRESS_LABEL=
# For the egress profile (Mullvad WireGuard config values):
# EGRESS_VPN_PROVIDER=mullvad
# EGRESS_WIREGUARD_PRIVATE_KEY=
# EGRESS_WIREGUARD_ADDRESSES=
# EGRESS_COUNTRY=Romania

# --- Social capture worker (Kali VM) -----------------------------------------------
# Personas' logged-in browser sessions live on the Kali VM; its worker connects
# out to this platform and runs captures (see kali-worker/). Shared secret the
# worker authenticates with; unset = the /worker API and social capture are off.
# OSINT_WORKER_TOKEN=

# --- Data --------------------------------------------------------------------------
# OSINT_RETENTION_DAYS=90
# OSINT_MAX_CALLS_PER_SCAN=60
# OSINT_MAX_PIVOTS_PER_TYPE=10
