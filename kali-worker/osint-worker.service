# systemd unit for the OSINT social worker on Kali.
#   sudo cp osint-worker.service /etc/systemd/system/
#   sudo systemctl enable --now osint-worker
[Unit]
Description=OSINT social capture worker (Playwright + personas)
After=network-online.target mullvad-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=kali
EnvironmentFile=/home/kali/osint-worker/osint-worker.env
WorkingDirectory=/home/kali/osint-worker
ExecStart=/home/kali/osint-worker/.venv/bin/python worker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
