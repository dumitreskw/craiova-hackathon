# osint social worker — config for the Kali VM (copy to osint-worker.env).
# The worker connects OUT to the platform; nothing listens on Kali.

OSINT_PLATFORM_URL=https://osint.dumisoft.ro
# Must match the platform's OSINT_WORKER_TOKEN (generate: openssl rand -hex 32).
OSINT_WORKER_TOKEN=
# Only if a proxy in front of the platform asks for basic auth (user:pass); usually blank.
OSINT_BASIC_AUTH=

# Where persona browser profiles live (one logged-in session each).
OSINT_PERSONA_DIR=/home/kali/personas
# Refuse captures unless Mullvad is connected (1 = on, strongly recommended).
OSINT_REQUIRE_VPN=1
# Desktop display used for the one-time manual logins (login jobs).
OSINT_WORKER_HEADFUL_DISPLAY=:0
# Leave unset to use the browser `playwright install chromium` downloaded into
# the venv. Set to "chromium" to drive a system Chromium instead.
# OSINT_CHROMIUM_CHANNEL=chromium
